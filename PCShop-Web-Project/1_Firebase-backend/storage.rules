rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthorizedOwner() {
      return request.auth != null &&
             request.auth.token.email in [
               "te.email.cimed@gmail.com",
               "baratod.email.cime@gmail.com"
             ];
    }

    match /{allPaths=**} {
      allow read: if isAuthorizedOwner();
      allow write: if isAuthorizedOwner() && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
